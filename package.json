{
  "name": "gt7-race-engineer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GT7 Race Engineer: live telemetry dashboard, lap analysis and MCP coach for Gran Turismo 7",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "sim": "tsx packages/protocol/src/cli/sim.ts",
    "sniff": "tsx packages/protocol/src/cli/sniff.ts",
    "gen-recording": "tsx packages/protocol/src/cli/gen-recording.ts",
    "dev": "echo \"dev: to be implemented in a later wave (server + web)\"",
    "start": "echo \"start: to be implemented in a later wave (server)\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
